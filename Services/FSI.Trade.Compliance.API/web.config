<?xml version="1.0" encoding="utf-8"?>
<!--
  Ships with the API publish output so the deployed app always carries the
  hosting settings below. `dotnet publish` DETECTS this file and only rewrites
  the aspNetCore processPath/arguments to match the published assembly — every
  other element here (notably <environmentVariables>) is preserved verbatim.

  Why ASPNETCORE_ENVIRONMENT is pinned: a clean publish emits a web.config with
  NO environment variable, so the app defaults to "Production" and trips the
  startup guard (Integration:Brains:Mode = Sandbox is not permitted in
  Production -> HTTP 500.30). Setting it to "Development" here keeps Sandbox
  Brains mode allowed. If/when Brains runs in a non-sandbox mode in prod, change
  this value to "Production" (or "Staging") instead of removing it.

  This makes the setting part of the deployment ARTIFACT, not a manual post-copy
  step that gets wiped on every redeploy.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        Remove IIS WebDAV so PUT / DELETE reach the app. WebDAVModule is a
        global IIS module that intercepts PUT/DELETE before the aspNetCore
        handler and returns 405 Method Not Allowed — this is the classic cause
        of "PUT works on Kestrel/localhost but 405 in IIS (UAT/Prod)". We drop
        both the module and its handler so all verbs flow to AspNetCoreModuleV2.
      -->
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        Belt-and-braces: explicitly allow PUT/DELETE at the Request Filtering
        layer in case a parent site / applicationHost denies "unlisted" verbs.
        NOTE: if the server LOCKS <requestFiltering> at a higher level this will
        surface as a 500.19 config error instead of 405 — if that happens, the
        verb deny-list lives at the parent and must be fixed there.
      -->
      <security>
        <requestFiltering>
          <!--
            Align IIS's request-filtering body cap with the app's per-upload limit
            (DocumentController / TransactionController: [RequestSizeLimit(50_000_000)]).
            In-process hosting makes IIS's maxAllowedContentLength the AUTHORITATIVE
            gate — its default (30,000,000 bytes ≈ 28.6 MB) rejects an oversize upload
            BEFORE the app can honour its higher limit, which surfaced in UAT as a
            failed upload (401 + login modal) for files between ~28.6 MB and 50 MB.
            52,428,800 = 50 MB. Keep this >= the app's [RequestSizeLimit].
            NOTE: if a parent site / applicationHost.config LOCKS <requestFiltering>,
            this throws 500.19 and the limit must be raised at that parent instead.
          -->
          <requestLimits maxAllowedContentLength="52428800" />
          <verbs allowUnlisted="true">
            <add verb="PUT" allowed="true" />
            <add verb="DELETE" allowed="true" />
            <add verb="PATCH" allowed="true" />
          </verbs>
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet"
                  arguments=".\FSI.Trade.Compliance.API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
